# 16 MB flash; the partition table is in partitions-jade.csv
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y

# BreezyBox owns UART0 (the board's "UART"/"COM" USB port); MicroPython's REPL is on native USB
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_VFS_MAX_COUNT=12
CONFIG_BREEZYBOX_SHELL_SCRIPTING=y

# LittleFS for /root
CONFIG_LITTLEFS_MAX_PARTITIONS=2
CONFIG_LITTLEFS_USE_MTIME=y
CONFIG_LITTLEFS_SPIFFS_COMPAT=n

# sockets for the HTTP server plus TLS to the model API
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
